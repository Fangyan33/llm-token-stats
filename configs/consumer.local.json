{
  "kafka": {
    "bootstrap_servers": [
      "kafka:9092"
    ],
    "topic": "llm-metering-events"
  },
  "consumer": {
    "health_listen": "0.0.0.0:9092",
    "group_id": "llm-metering-doris-v1",
    "accepted_config_versions": [
      "collection-v1"
    ],
    "accepted_routes": [
      {
        "route_name": "llm-chat",
        "service_id": "model-service-a"
      }
    ]
  },
  "doris": {
    "fe_url": "http://doris:8040",
    "allowed_load_hosts": [
      "doris:8030",
      "doris:8040"
    ],
    "database": "metering",
    "dsn_env": "DORIS_DSN",
    "username_env": "DORIS_USER",
    "password_env": "DORIS_PASSWORD"
  }
}
