{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway observer config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "config_version",
    "observer_cluster",
    "routes",
    "chunk_bytes",
    "response_body_max_bytes",
    "ack_timeout_ms",
    "end_ack_timeout_ms",
    "observation_max_ms",
    "tick_ms",
    "metadata_max_bytes",
    "ack_max_bytes",
    "pod_max_observations",
    "pod_inflight_bytes",
    "pod_inflight_messages",
    "transport_streams_per_worker",
    "transport_batch_max_bytes",
    "transport_batch_max_frames"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "config_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "observer_cluster": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "routes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_name",
          "methods",
          "paths",
          "adapter_id"
        ],
        "properties": {
          "route_name": {
            "description": "精确路由名；单独的 * 表示忽略路由名，仍按 method/path 和顶层 Host 白名单筛选，包括路由名不可读的请求。事件单独记录实际 Envoy 路由名，不可读时为 unknown。规则按配置顺序选择，先命中的路由规则决定启用与路径匹配。",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "methods": {
            "const": [
              "POST"
            ]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^/[^?#*\\[\\]{}()|^$\\\\]*$"
            }
          },
          "adapter_id": {
            "const": "chat_completions_v1"
          }
        }
      }
    },
    "chunk_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "response_body_max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "ack_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "end_ack_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "observation_max_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "tick_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "metadata_max_bytes": {
      "type": "integer",
      "minimum": 6144,
      "maximum": 6144,
      "default": 6144
    },
    "ack_max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "accepted_request_hosts": {
      "description": "采集 Host 白名单：精确 DNS 域名、*.example.com（任意层级子域名，不含根域名）或 *（所有合法 DNS Host）。缺省或空数组不采集；规则转小写并去末尾根点，拒绝端口、IP、其他通配符和规范化后的重复项。",
      "type": "array",
      "default": [],
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "(?:\\*|(?:\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\\.?)"
      }
    },
    "logical_request_id_headers": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
      },
      "description": "按优先级选择首个合法客户端请求 ID；名称忽略大小写且不得重复；缺省或空列表不采集。"
    },
    "user_id_header": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "default": [
        "user-id"
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
      }
    },
    "extra_request_headers": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
      }
    },
    "pod_max_observations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 131072
    },
    "pod_inflight_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 268435456
    },
    "pod_inflight_messages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 524288
    },
    "transport_streams_per_worker": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 4
    },
    "transport_batch_max_bytes": {
      "type": "integer",
      "minimum": 32768,
      "maximum": 32768,
      "default": 32768
    },
    "transport_batch_max_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128,
      "default": 128
    },
    "metrics_enabled": {
      "type": "boolean",
      "default": false,
      "description": "启用 Wasm 自定义 metering_* 指标；默认关闭，不影响采集和额度控制。资源 Gauge 每秒汇总。"
    }
  }
}
