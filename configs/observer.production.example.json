{
  "kafka": {
    "bootstrap_servers": [
      "kafka.kafka.svc.cluster.local:9093"
    ],
    "topic": "llm-metering-events",
    "ca_file": "/secrets/kafka/ca.crt",
    "username_env": "KAFKA_USERNAME",
    "password_env": "KAFKA_PASSWORD",
    "producer_max_records": 16384,
    "producer_max_bytes": 67108864,
    "producer_batch_bytes": 1048576,
    "producer_linger_ms": 5,
    "producer_delivery_timeout_ms": 10000,
    "producer_watchdog_timeout_ms": 12000
  },
  "observer": {
    "wasm_download": {
      "listen": ":9093",
      "file": "/usr/share/metering/wasm/gateway-observer-v1.wasm"
    },
    "listen": ":9090",
    "health_listen": ":9091",
    "max_connections": 1024,
    "max_active_observations": 1048576,
    "parser_budget_bytes": 10737418240,
    "accepted_config_versions": [
      "collection-v1"
    ],
    "accepted_adapter_ids": [
      "chat_completions_v1"
    ],
    "cluster_name": "REPLACE_CLUSTER_NAME",
    "deployment_environment": "prd",
    "service_lookup": {
      "uri": "",
      "credential_env": "METERING_SERVICE_LOOKUP_TOKEN",
      "ca_file": "",
      "max_requests_per_second": 1000,
      "cache": {
        "enabled": true,
        "max_entries": 10000,
        "ttl_seconds": 1800,
        "stale_if_error_seconds": 900,
        "stale_retry_interval_seconds": 5
      }
    },
    "customer_lookup": {
      "uri": "",
      "credential_env": "METERING_CUSTOMER_LOOKUP_TOKEN",
      "ca_file": "",
      "max_requests_per_second": 1000,
      "cache": {
        "enabled": true,
        "max_entries": 10000,
        "ttl_seconds": 1800,
        "stale_if_error_seconds": 900,
        "stale_retry_interval_seconds": 5
      }
    },
    "lookup_timeout_ms": 200,
    "lookup_max_concurrency": 64,
    "receive_queue_batches": 4096,
    "receive_queue_bytes": 134217728,
    "request_body_max_bytes": 33554432,
    "request_tokenizer_workers": 0,
    "request_tokenizer_queue_requests": 200,
    "request_tokenizer_queue_bytes": 536870912
  }
}
