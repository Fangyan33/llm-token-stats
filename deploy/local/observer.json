{
  "kafka": {
    "bootstrap_servers": [
      "kafka:9092"
    ],
    "topic": "llm-metering-development",
    "producer_max_records": 16384,
    "producer_max_bytes": 67108864,
    "producer_batch_bytes": 1048576,
    "producer_linger_ms": 5,
    "producer_delivery_timeout_ms": 10000,
    "producer_watchdog_timeout_ms": 12000
  },
  "observer": {
    "wasm_download": {
      "listen": ":9093",
      "file": "/app/gateway-observer-v1.wasm"
    },
    "listen": "0.0.0.0:9090",
    "health_listen": "0.0.0.0:9091",
    "producer_id": "observer-test",
    "accepted_config_versions": [
      "collection-v1"
    ],
    "accepted_adapter_ids": [
      "chat_completions_v1"
    ],
    "cluster_name": "local-cluster",
    "deployment_environment": "dev",
    "service_lookup": {
      "uri": "",
      "credential_env": "METERING_SERVICE_LOOKUP_TOKEN",
      "ca_file": "",
      "max_requests_per_second": 1000,
      "cache": {
        "enabled": true,
        "max_entries": 10000,
        "ttl_seconds": 1800,
        "stale_if_error_seconds": 900,
        "stale_retry_interval_seconds": 5
      }
    },
    "customer_lookup": {
      "uri": "",
      "credential_env": "METERING_CUSTOMER_LOOKUP_TOKEN",
      "ca_file": "",
      "max_requests_per_second": 1000,
      "cache": {
        "enabled": true,
        "max_entries": 10000,
        "ttl_seconds": 1800,
        "stale_if_error_seconds": 900,
        "stale_retry_interval_seconds": 5
      }
    },
    "lookup_timeout_ms": 200,
    "lookup_max_concurrency": 64,
    "receive_queue_batches": 4096,
    "receive_queue_bytes": 134217728
  }
}
